# Optional AI provider (OpenAI-compatible) for caption / text bindings.
# Can also be set in-app via Settings.
VITE_AI_BASE_URL=https://api.openai.com/v1
VITE_AI_API_KEY=
VITE_AI_MODEL=gpt-4o-mini

# Copy to apps/desktop/.env (dev) and apps/desktop/.env.production (build).
# Vite embeds VITE_* into the app bundle at build time.
# Primary: Tailscale (works from home, office, mobile — Tailscale app must be connected).
VITE_NC_URL=http://100.74.131.110:8080
# Fallback when on the same LAN as the server (auto-tried if Tailscale unreachable).
VITE_NC_LAN_URL=http://192.168.110.101:8080
VITE_NC_TOKEN=
VITE_NC_BASE_ID=pcq7mr8crku2d9o
VITE_NC_PROVINCE=dalat
